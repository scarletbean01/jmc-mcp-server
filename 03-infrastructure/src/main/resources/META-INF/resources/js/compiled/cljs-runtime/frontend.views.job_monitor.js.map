(ns frontend.views.job-monitor
  (:require
   [re-frame.core :as re-frame]
   [reagent.core :as reagent]
   [re-com.core :as re-com :refer [at]]
   [frontend.subs :as subs]
   [frontend.views.components :as components :refer [md-icon]]))

(defn job-item [job-id job]
  (let [status (:status job)
        progress (or (:progressPercent job) 0)
        status-color (case status
                       :pending "#f59e0b"
                       :running "#3b82f6"
                       :completed "#22c55e"
                       :failed "#ef4444"
                       "#64748b")]
    [:div {:style {:border-bottom "1px solid #f1f5f9"
                   :padding "12px 0"}}
     [re-com/h-box
      :src (at)
      :justify :between
      :align :center
      :children [[re-com/v-box
                  :src (at)
                  :gap "2px"
                  :children [[re-com/label
                              :src (at)
                              :label (str "Job: " job-id)
                              :style {:font-weight "600" :font-size "0.875rem"}]
                             [re-com/label
                              :src (at)
                              :label (str "Recording: " (:recording-id job))
                              :style {:font-size "0.75rem" :color "#94a3b8"}]]]
                 [:span {:style {:padding "2px 8px"
                                 :border-radius "9999px"
                                 :background-color (str status-color "15")
                                 :color status-color
                                 :font-size "0.75rem"
                                 :font-weight "700"
                                 :border (str "1px solid " status-color "30")}}
                  (name status)]]]
     (when (#{:pending :running} status)
       [:div {:style {:margin-top "8px"}}
        [:div {:style {:height "6px"
                       :background-color "#f1f5f9"
                       :border-radius "9999px"
                       :overflow "hidden"}}
         [:div {:style {:height "100%"
                        :width (str progress "%")
                        :background-color "#3b82f6"
                        :transition "width 0.3s ease-in-out"}}]]])]))

(defn job-monitor []
  (let [scheduled (reagent/atom #{})]
    (fn []
      (let [jobs @(re-frame/subscribe [:jobs/all])]
        ;; Auto-remove completed/failed jobs after 10 seconds
        (doseq [[id job] jobs]
          (when (and (#{:completed :failed} (:status job))
                     (not (contains? @scheduled id)))
            (swap! scheduled conj id)
            (js/setTimeout #(re-frame/dispatch [:job/remove id]) 10000)))
        (when (seq jobs)
          [:div {:class "card"
                 :style {:position "fixed"
                         :bottom "1.5rem"
                         :right "1.5rem"
                         :width "360px"
                         :max-height "400px"
                         :overflow-y "auto"
                         :z-index 9998
                         :padding "1rem"
                         :box-shadow "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)"}}
           [re-com/v-box
            :src (at)
            :children (vec (concat
                            [[re-com/h-box
                              :src (at)
                              :justify :between
                              :align :center
                              :style {:border-bottom "1px solid #e2e8f0"
                                      :padding-bottom "8px"
                                      :margin-bottom "4px"}
                              :children [[re-com/label
                                          :src (at)
                                          :label "ACTIVE JOBS"
                                          :style {:font-weight "700" :font-size "0.75rem" :color "#64748b" :letter-spacing "0.05em"}]
                                         [re-com/md-icon-button
                                          :src (at)
                                          :md-icon-name "zmdi-close"
                                          :size :smaller
                                          :on-click #(doseq [id (keys jobs)]
                                                       (re-frame/dispatch [:job/remove id]))
                                          :style {:color "#94a3b8"}]]]]
                            (for [[id job] jobs]
                              ^{:key id}
                              [job-item id job])))]])))))
