(ns frontend.fx
  (:require
   [re-frame.core :as re-frame]
   [reitit.frontend.easy :as rfe]
   [ajax.core :as ajax]))

(re-frame/reg-fx
 :http
 (fn [{:keys [method uri params body headers on-success on-failure on-progress timeout response-format format]}]
   (let [success-handler (fn [response]
                           (when on-success
                             (re-frame/dispatch (conj on-success response))))
         error-handler (fn [response]
                         (when on-failure
                             (re-frame/dispatch (conj on-failure response))))
         progress-handler (when on-progress
                            (fn [e]
                              (when (.-lengthComputable e)
                                (let [percent (* 100 (/ (.-loaded e) (.-total e)))]
                                  (re-frame/dispatch (conj on-progress percent))))))
         opts (cond-> {:handler success-handler
                       :error-handler error-handler
                       :timeout (or timeout 30000)
                       :response-format (or response-format
                                            (ajax/json-response-format {:keywords? true}))}
                params (assoc :params params)
                body (assoc :body body)
                headers (assoc :headers headers)
                format (assoc :format format)
                (and (nil? format) (nil? body)) (assoc :format (ajax/json-request-format))
                progress-handler (assoc :progress-handler progress-handler))]
     (case method
       :get    (ajax/GET uri opts)
       :post   (ajax/POST uri opts)
       :put    (ajax/PUT uri opts)
       :delete (ajax/DELETE uri opts)
       (ajax/GET uri opts)))))

(re-frame/reg-fx
 :sse/connect
 (fn [{:keys [url on-message on-error on-open]}]
   (let [source (js/EventSource. url)]
     (set! (.-onmessage source)
           (fn [e]
             (let [data (js->clj (js/JSON.parse (.-data e)) :keywordize-keys true)]
               (when on-message
                 (re-frame/dispatch (conj on-message data))))))
     (set! (.-onerror source)
           (fn [e]
             (when on-error
               (re-frame/dispatch (conj on-error e)))
             (.close source)))
     (set! (.-onopen source)
           (fn [e]
             (when on-open
               (re-frame/dispatch (conj on-open e))))))))

(re-frame/reg-fx
 :notify
 (fn [notification]
   (re-frame/dispatch [:notification/add notification])))

(re-frame/reg-fx
 :navigate
 (fn [route]
   (if (vector? route)
     (apply rfe/push-state route)
     (rfe/push-state route))))

(re-frame/reg-fx
 :dispatch-later
 (fn [{:keys [ms dispatch]}]
   (js/setTimeout #(re-frame/dispatch dispatch) ms)))
