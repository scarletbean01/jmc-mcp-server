(ns frontend.api.client
  (:require
   [frontend.config :as config]
   [ajax.core :as ajax]))

(defn health-check []
  {:method :get
   :uri (str config/api-url "/health")
   :on-success [:health/loaded]
   :on-failure [:health/failed]})

(defn get-recordings []
  {:method :get
   :uri (str config/api-url "/recordings")
   :on-success [:library/recordings-loaded]
   :on-failure [:library/recordings-failed]})

(defn get-recording-info [id]
  {:method :get
   :uri (str config/api-url "/recordings/" id)
   :on-success [:recording/info-loaded]
   :on-failure [:recording/info-failed]})

(defn delete-recording [id]
  {:method :delete
   :uri (str config/api-url "/recordings/" id)
   :on-success [:library/recording-deleted]
   :on-failure [:library/recording-delete-failed]})

(defn upload-recording [file]
  (let [form-data (js/FormData.)]
    (.append form-data "file" file)
    {:method :post
     :uri (str config/api-url "/recordings/upload")
     :body form-data
     :on-success [:upload/success]
     :on-failure [:upload/failure]
     :on-progress [:upload/progress]}))

(defn- analysis-params->body [params]
  (let [body (cond-> {}
               (:start-time params) (assoc :startTime (:start-time params))
               (:end-time params)   (assoc :endTime (:end-time params))
               (:topN params)       (assoc-in [:params :topN] (:topN params))
               (:package-prefix params) (assoc-in [:params :packagePrefix] (:package-prefix params))
               (:thread-name params)    (assoc-in [:params :threadName] (:thread-name params)))]
    (.stringify js/JSON (clj->js body))))

(defn run-analysis [id type params]
  {:method :post
   :uri (str config/api-url "/recordings/" id "/analyze/" (name type))
   :body (analysis-params->body params)
   :headers {"Content-Type" "application/json"}
   :response-format (ajax/json-response-format {:keywords? true})
   :on-success [:analysis/result]
   :on-failure [:analysis/failed]})

(defn run-analysis-async [id type params]
  {:method :post
   :uri (str config/api-url "/recordings/" id "/analyze/" (name type) "/async")
   :body (analysis-params->body params)
   :headers {"Content-Type" "application/json"}
   :response-format (ajax/json-response-format {:keywords? true})
   :on-success [:analysis/async-started]
   :on-failure [:analysis/failed]})

(defn get-job-status [id job-id]
  {:method :get
   :uri (str config/api-url "/recordings/" id "/analyze/jobs/" job-id)
   :on-success [:job/update]
   :on-failure [:job/status-failed]})

(defn connect-sse [id job-id]
  {:url (str config/api-url "/recordings/" id "/analyze/jobs/" job-id "/stream")
   :on-message [:job/sse-message]
   :on-error [:job/sse-failed]
   :on-open [:job/sse-opened]})

(defn run-comparison [baseline-id target-id]
  {:method :post
   :uri (str config/api-url "/compare/structured")
   :body (.stringify js/JSON (clj->js {:baselineRecordingId baseline-id :comparisonRecordingId target-id}))
   :headers {"Content-Type" "application/json"}
   :response-format (ajax/json-response-format {:keywords? true})
   :on-success [:comparison/result]
   :on-failure [:comparison/error]})
