(ns frontend.events
  (:require
   [re-frame.core :as re-frame]
   [frontend.db :as db]
   [frontend.api.client :as api]))

;; Global

(re-frame/reg-event-fx
 :initialize-db
 (fn [_ _]
   {:db db/default-db}))

(re-frame/reg-event-fx
 :route/changed
 (fn [{:keys [db]} [_ match]]
   (let [route-name (-> match :data :name)
         params (:path-params match)
         prev-id (get-in db [:recording-detail :recording-id])
         new-id (:id params)]
     (merge {:db (-> db
                     (assoc-in [:route :current] route-name)
                     (assoc-in [:route :params] params)
                     (cond-> (and (= route-name :recording) (not= prev-id new-id))
                       (-> (assoc-in [:recording-detail :active-analysis] nil)
                           (assoc-in [:recording-detail :error] nil)
                           (assoc-in [:recording-detail :loading?] false))))}
            (case route-name
              :library {:dispatch [:library/load-recordings]}
              :recording {:dispatch [:recording/load-info (:id params)]}
              :compare {:dispatch [:library/load-recordings]}
              nil)))))

(re-frame/reg-event-fx
 :notification/add
 (fn [{:keys [db]} [_ {:keys [type message] :as notification}]]
   (let [id (str (random-uuid))]
     {:db (update db :notifications conj (assoc notification :id id))
      :dispatch-later {:ms 5000 :dispatch [:notification/remove id]}})))

(re-frame/reg-event-db
 :notification/remove
 (fn [db [_ id]]
   (update db :notifications #(vec (remove (comp #{id} :id) %)))))

(re-frame/reg-event-fx
 :navigate
 (fn [_ [_ route]]
   {:navigate route}))

(re-frame/reg-event-db
 :ui/toggle-sidebar
 (fn [db _]
   (update-in db [:ui :sidebar-collapsed?] not)))

;; Library

(re-frame/reg-event-fx
 :library/load-recordings
 (fn [{:keys [db]} _]
   {:db (assoc-in db [:recordings :loading?] true)
    :http (api/get-recordings)}))

(re-frame/reg-event-fx
 :library/recordings-loaded
 (fn [{:keys [db]} [_ response]]
   (if (:success response)
     {:db (-> db
              (assoc-in [:recordings :items] (:data response))
              (assoc-in [:recordings :loading?] false)
              (assoc-in [:recordings :error] nil))}
     {:db (-> db
              (assoc-in [:recordings :loading?] false)
              (assoc-in [:recordings :error] (:error response)))
      :notify {:type :error :message (str "Failed to load recordings: " (:error response))}})))

(re-frame/reg-event-fx
 :library/recordings-failed
 (fn [{:keys [db]} [_ response]]
   {:db (-> db
            (assoc-in [:recordings :loading?] false)
            (assoc-in [:recordings :error] "Failed to load recordings"))
    :notify {:type :error :message "Failed to load recordings"}}))

(re-frame/reg-event-fx
 :library/delete-recording
 (fn [_ [_ id]]
   {:http (api/delete-recording id)}))

(re-frame/reg-event-fx
 :library/recording-deleted
 (fn [_ [_ response]]
   {:dispatch [:library/load-recordings]
    :notify {:type :success :message "Recording deleted"}}))

(re-frame/reg-event-fx
 :library/recording-delete-failed
 (fn [_ [_ response]]
   {:notify {:type :error :message "Failed to delete recording"}}))

;; Upload

(re-frame/reg-event-db
 :upload/select-file
 (fn [db [_ file]]
   (-> db
       (assoc-in [:upload :file] file)
       (assoc-in [:upload :error] nil))))

(re-frame/reg-event-fx
 :upload/submit
 (fn [{:keys [db]} _]
   (let [file (get-in db [:upload :file])]
     (if file
       {:db (assoc-in db [:upload :status] :uploading)
        :http (api/upload-recording file)}
       {:notify {:type :warning :message "Please select a file first"}}))))

(re-frame/reg-event-db
 :upload/progress
 (fn [db [_ percent]]
   (assoc-in db [:upload :progress] percent)))

(re-frame/reg-event-fx
 :upload/success
 (fn [{:keys [db]} [_ response]]
   (if (:success response)
     (let [recording-id (get-in response [:data :recordingId])]
       {:db (-> db
                (assoc-in [:upload :status] :idle)
                (assoc-in [:upload :progress] 0)
                (assoc-in [:upload :error] nil)
                (assoc-in [:upload :file] nil))
        :notify {:type :success :message "Recording uploaded successfully"}
        :dispatch-n [[:library/load-recordings]
                     (when recording-id
                       [:navigate [:recording {:id recording-id}]])]})
     {:db (-> db
              (assoc-in [:upload :status] :error)
              (assoc-in [:upload :error] (:error response)))
      :notify {:type :error :message (str "Upload failed: " (:error response))}})))

(re-frame/reg-event-fx
 :upload/failure
 (fn [{:keys [db]} [_ response]]
   {:db (-> db
            (assoc-in [:upload :status] :error)
            (assoc-in [:upload :error] (or (:error response) "Upload failed")))
    :notify {:type :error :message "Upload failed"}}))

;; Recording detail

(re-frame/reg-event-fx
 :recording/load-info
 (fn [{:keys [db]} [_ id]]
   {:db (-> db
            (assoc-in [:recording-detail :recording-id] id)
            (assoc-in [:recording-detail :loading?] true))
    :http (api/get-recording-info id)}))

(re-frame/reg-event-fx
 :recording/info-loaded
 (fn [{:keys [db]} [_ response]]
   (if (:success response)
     (let [recording-id (get-in db [:recording-detail :recording-id])
           active-analysis (get-in db [:recording-detail :active-analysis])
           has-overview? (get-in db [:recording-detail :results recording-id :overview])]
       (merge {:db (-> db
                       (assoc-in [:recording-detail :info] (:data response))
                       (assoc-in [:recording-detail :loading?] false)
                       (assoc-in [:recording-detail :error] nil))}
              (when (and (nil? active-analysis) (not has-overview?) recording-id)
                {:dispatch-n [[:analysis/select-type :overview]
                              [:analysis/run-sync]]})))
     {:db (-> db
              (assoc-in [:recording-detail :error] (:error response))
              (assoc-in [:recording-detail :loading?] false))})))

(re-frame/reg-event-fx
 :recording/info-failed
 (fn [{:keys [db]} [_ response]]
   {:db (-> db
            (assoc-in [:recording-detail :loading?] false)
            (assoc-in [:recording-detail :error] "Failed to load recording info"))
    :notify {:type :error :message "Failed to load recording info"}}))

;; Analysis

(re-frame/reg-event-db
 :analysis/select-type
 (fn [db [_ analysis-type]]
   (assoc-in db [:recording-detail :active-analysis] analysis-type)))

(re-frame/reg-event-db
 :analysis/update-params
 (fn [db [_ key value]]
   (assoc-in db [:recording-detail :analysis-params key] value)))

(re-frame/reg-event-fx
 :analysis/run
 (fn [{:keys [db]} [_ sync?]]
   (let [id (get-in db [:recording-detail :recording-id])
         analysis-type (get-in db [:recording-detail :active-analysis])
         params (get-in db [:recording-detail :analysis-params])]
     (if (and id analysis-type)
       {:db (assoc-in db [:recording-detail :loading?] true)
        :http (if sync?
                (api/run-analysis id analysis-type params)
                (api/run-analysis-async id analysis-type params))}
       {:notify {:type :warning :message "Please select an analysis type"}}))))

(re-frame/reg-event-fx
 :analysis/run-sync
 (fn [_ _]
   {:dispatch [:analysis/run true]}))

(re-frame/reg-event-fx
 :analysis/run-async
 (fn [_ _]
   {:dispatch [:analysis/run false]}))

(re-frame/reg-event-db
 :analysis/result
 (fn [db [_ response]]
   (let [recording-id (get-in db [:recording-detail :recording-id])
         analysis-type (get-in db [:recording-detail :active-analysis])]
     (if (:success response)
       (-> db
           (assoc-in [:recording-detail :results recording-id analysis-type] (:data response))
           (assoc-in [:recording-detail :loading?] false)
           (assoc-in [:recording-detail :error] nil))
       (-> db
           (assoc-in [:recording-detail :error] (:error response))
           (assoc-in [:recording-detail :loading?] false))))))

(re-frame/reg-event-fx
 :analysis/async-started
 (fn [{:keys [db]} [_ response]]
   (if (:success response)
     (let [job-id (get-in response [:data :jobId])
           recording-id (get-in db [:recording-detail :recording-id])]
       {:db (-> db
                (assoc-in [:recording-detail :loading?] false)
                (assoc-in [:jobs job-id] {:status :pending
                                          :recording-id recording-id
                                          :progress 0}))
        :sse/connect (api/connect-sse recording-id job-id)
        :notify {:type :info :message (str "Analysis job started: " job-id)}})
     {:db (assoc-in db [:recording-detail :loading?] false)
      :notify {:type :error :message (str "Failed to start analysis: " (:error response))}})))

(re-frame/reg-event-fx
 :analysis/failed
 (fn [{:keys [db]} [_ response]]
   {:db (assoc-in db [:recording-detail :loading?] false)
    :notify {:type :error :message (or (:error response) "Analysis failed")}}))

;; Jobs

(re-frame/reg-event-db
 :job/update
 (fn [db [_ response]]
   (if (:success response)
     (let [job-id (get-in response [:data :jobId])]
       (assoc-in db [:jobs job-id] (:data response)))
     db)))

(re-frame/reg-event-db
 :job/sse-message
 (fn [db [_ data]]
   (let [job-id (:jobId data)]
     (if job-id
       (update-in db [:jobs job-id] merge data)
       db))))

(re-frame/reg-event-fx
 :job/sse-failed
 (fn [_ [_ error]]
   {:notify {:type :error :message "SSE connection failed"}}))

(re-frame/reg-event-db
 :job/sse-opened
 (fn [db _]
   db))

(re-frame/reg-event-db
 :job/remove
 (fn [db [_ job-id]]
   (update db :jobs dissoc job-id)))

(re-frame/reg-event-fx
 :job/status-failed
 (fn [_ [_ response]]
   {:notify {:type :error :message "Failed to fetch job status"}}))

;; Comparison

(re-frame/reg-event-db
 :comparison/select-baseline
 (fn [db [_ id]]
   (assoc-in db [:comparison :baseline-id] id)))

(re-frame/reg-event-db
 :comparison/select-target
 (fn [db [_ id]]
   (assoc-in db [:comparison :target-id] id)))

(re-frame/reg-event-fx
 :comparison/run
 (fn [{:keys [db]} _]
   (let [baseline (get-in db [:comparison :baseline-id])
         target (get-in db [:comparison :target-id])]
     (if (and baseline target)
       {:db (assoc-in db [:comparison :loading?] true)
        :http (api/run-comparison baseline target)}
       {:notify {:type :warning :message "Please select both recordings"}}))))

(re-frame/reg-event-db
 :comparison/result
 (fn [db [_ response]]
   (if (:success response)
     (-> db
         (assoc-in [:comparison :result] (:data response))
         (assoc-in [:comparison :loading?] false)
         (assoc-in [:comparison :error] nil))
     (-> db
         (assoc-in [:comparison :error] (:error response))
         (assoc-in [:comparison :loading?] false)))))

(re-frame/reg-event-fx
 :comparison/error
 (fn [{:keys [db]} [_ response]]
   {:db (-> db
            (assoc-in [:comparison :error] (:error response))
            (assoc-in [:comparison :loading?] false))
    :notify {:type :error :message (or (:error response) "Comparison failed")}}))

;; Health

(re-frame/reg-event-db
 :health/loaded
 (fn [db [_ response]]
   (if (:success response)
     (assoc db :health (:data response))
     db)))

(re-frame/reg-event-fx
 :health/failed
 (fn [_ _]
   {:notify {:type :error :message "Health check failed"}}))
