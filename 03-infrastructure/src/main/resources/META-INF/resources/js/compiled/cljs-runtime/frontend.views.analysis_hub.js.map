(ns frontend.views.analysis-hub
  (:require
    [clojure.string :as str]
    [frontend.analysis-config :as ac]
    [frontend.views.components :as components :refer [md-icon]]
    [re-com.core :as re-com :refer [at]]
    [re-frame.core :as re-frame]
    [reagent.core :as reagent]))

(defn analysis-type-label [t]
      (-> (name t)
          (str/replace "-" " ")
          (str/capitalize)))

(defn result-renderer [analysis-type data]
      (let [shape (get ac/analysis-shapes analysis-type :metrics)]
           [re-com/v-box
            :src (at)
            :gap "1.5rem"
            :children [[re-com/title
                        :src (at)
                        :label (str "Analysis: " (analysis-type-label analysis-type))
                        :level :level3
                        :style {:margin "0" :font-weight "700" :color "#0f172a"}]
                       (case shape
                             :metrics [components/metrics-renderer data]
                             :table [components/table-renderer data]
                             :tree [components/tree-renderer data]
                             :flame-graph [components/flame-graph-placeholder data]
                             :timeline [components/timeline-placeholder data]
                             [components/metrics-renderer data])]]))

(defn- matches-search? [search-text t]
       (str/includes? (str/lower-case (analysis-type-label t))
                      (str/lower-case (or search-text ""))))

(defn category-section [category active-analysis search-text]
      (let [collapsed? (reagent/atom false)]
           (fn [category active-analysis search-text]
               (let [filtered-types (filter #(matches-search? search-text %) (:types category))]
                    (when (seq filtered-types)
                          [:div {:style {:margin-bottom "4px"}}
                           [:div {:style    {:padding         "8px 12px"
                                             :cursor          "pointer"
                                             :display         "flex"
                                             :align-items     "center"
                                             :justify-content "space-between"
                                             :border-radius   "6px"
                                             :transition      "background-color 0.2s"}
                                  :on-click #(swap! collapsed? not)
                                  :class    "category-header"}
                            [re-com/label
                             :src (at)
                             :label (:name category)
                             :style {:font-weight "600" :font-size "0.8125rem" :color "#475569"}]
                            [md-icon
                             :md-icon-name (if @collapsed? "zmdi-chevron-right" "zmdi-chevron-down")
                             :size :small
                             :style {:color "#94a3b8"}]]
                           (when-not @collapsed?
                                     [:div {:style {:padding "2px 0 8px 8px"}}
                                      (for [t filtered-types]
                                           ^{:key t}
                                           [:div {:style    (merge {:padding       "6px 12px"
                                                                    :margin        "2px 0"
                                                                    :cursor        "pointer"
                                                                    :border-radius "6px"
                                                                    :font-size     "0.875rem"
                                                                    :transition    "all 0.2s"}
                                                                   (if (= active-analysis t)
                                                                     {:background-color "#eff6ff" :color "#2563eb" :font-weight "500"}
                                                                     {:color "#64748b"}))
                                                  :on-click #(re-frame/dispatch [:analysis/select-type t])}
                                            (analysis-type-label t)])])])))))

(defn analysis-hub-view []
      (let [search-text (reagent/atom "")]
           (fn []
               (let [info @(re-frame/subscribe [:recording-detail/info])
                     recording-id @(re-frame/subscribe [:recording-detail/recording-id])
                     active-analysis @(re-frame/subscribe [:recording-detail/active-analysis])
                     params @(re-frame/subscribe [:recording-detail/analysis-params])
                     result @(re-frame/subscribe [:recording-detail/result-for-active])
                     loading? @(re-frame/subscribe [:recording-detail/loading?])
                     error @(re-frame/subscribe [:recording-detail/error])]
                    [re-com/h-box
                     :src (at)
                     :size "1"
                     :gap "2rem"
                     :children [[re-com/v-box
                                 :src (at)
                                 :width "280px"
                                 :gap "1rem"
                                 :children [[re-com/v-box
                                             :src (at)
                                             :gap "12px"
                                             :children [[re-com/title
                                                         :src (at)
                                                         :label "Analysis Types"
                                                         :level :level4
                                                         :style {:margin "0" :font-weight "700" :color "#334155"}]
                                                        [re-com/input-text
                                                         :src (at)
                                                         :model search-text
                                                         :placeholder "Search types..."
                                                         :change-on-blur? false
                                                         :on-change #(reset! search-text %)
                                                         :style {:border-radius "8px"}]]]
                                            [re-com/scroller
                                             :src (at)
                                             :size "1"
                                             :child [re-com/v-box
                                                     :src (at)
                                                     :gap "4px"
                                                     :children (vec (for [cat ac/analysis-categories]
                                                                         ^{:key (:name cat)}
                                                                         [category-section cat active-analysis @search-text]))]]]]
                                [re-com/v-box
                                 :src (at)
                                 :size "1"
                                 :gap "2rem"
                                 :children [[re-com/v-box
                                             :src (at)
                                             :gap "12px"
                                             :style {:border-bottom "1px solid #e2e8f0" :padding-bottom "1.5rem"}
                                             :children [[re-com/h-box
                                                         :src (at)
                                                         :justify :between
                                                         :align :center
                                                         :children [[re-com/title
                                                                     :src (at)
                                                                     :label (or (:filename info) "Recording")
                                                                     :level :level2
                                                                     :style {:margin "0" :font-weight "800" :color "#0f172a"}]
                                                                    [re-com/button
                                                                     :src (at)
                                                                     :label "Download JFR"
                                                                     :on-click #()
                                                                     :style {:color "#64748b"}]]]
                                                        [re-com/h-box
                                                         :src (at)
                                                         :gap "24px"
                                                         :children [[re-com/h-box :src (at) :gap "6px" :align :center :children [[md-icon :md-icon-name "zmdi-storage" :size :small :color "#94a3b8"] [re-com/label :src (at) :label (components/file-size-str (:size info)) :style {:color "#64748b"}]]]
                                                                    (when (:duration info)
                                                                          [re-com/h-box :src (at) :gap "6px" :align :center :children [[md-icon :md-icon-name "zmdi-time" :size :small :color "#94a3b8"] [re-com/label :src (at) :label (:duration info) :style {:color "#64748b"}]]])
                                                                    [re-com/h-box :src (at) :gap "6px" :align :center :children [[md-icon :md-icon-name "zmdi-layers" :size :small :color "#94a3b8"] [re-com/label :src (at) :label (str (or (:eventCount info) "-") " events") :style {:color "#64748b"}]]]]]]]
                                            (when error
                                                  [re-com/alert-box
                                                   :src (at)
                                                   :alert-type :danger
                                                   :body (str "Error: " error)
                                                   :closeable? true
                                                   :on-close #(re-frame/dispatch [:recording/load-info recording-id])])
                                            (when active-analysis
                                                  [:div {:class "card" :style {:background-color "#f8fafc" :border-style "dashed"}}
                                                   [re-com/v-box
                                                    :src (at)
                                                    :gap "1rem"
                                                    :children [[re-com/label
                                                                :src (at)
                                                                :label "ANALYSIS PARAMETERS"
                                                                :style {:font-weight "700" :font-size "0.75rem" :color "#64748b" :letter-spacing "0.05em"}]
                                                               [re-com/h-box
                                                                :src (at)
                                                                :gap "1.5rem"
                                                                :children [[re-com/v-box
                                                                            :src (at)
                                                                            :gap "4px"
                                                                            :children [[re-com/label :src (at) :label "Start Time" :style {:font-size "0.8125rem" :font-weight "500"}]
                                                                                       [re-com/input-text
                                                                                        :src (at)
                                                                                        :model (or (:start-time params) "")
                                                                                        :placeholder "ISO-8601"
                                                                                        :on-change #(re-frame/dispatch [:analysis/update-params :start-time %])
                                                                                        :style {:width "200px"}]]]
                                                                           [re-com/v-box
                                                                            :src (at)
                                                                            :gap "4px"
                                                                            :children [[re-com/label :src (at) :label "End Time" :style {:font-size "0.8125rem" :font-weight "500"}]
                                                                                       [re-com/input-text
                                                                                        :src (at)
                                                                                        :model (or (:end-time params) "")
                                                                                        :placeholder "ISO-8601"
                                                                                        :on-change #(re-frame/dispatch [:analysis/update-params :end-time %])
                                                                                        :style {:width "200px"}]]]
                                                                           [re-com/v-box
                                                                            :src (at)
                                                                            :gap "4px"
                                                                            :children [[re-com/label :src (at) :label "Top N" :style {:font-size "0.8125rem" :font-weight "500"}]
                                                                                       [re-com/input-text
                                                                                        :src (at)
                                                                                        :model (str (or (:topN params) 20))
                                                                                        :on-change #(let [n (js/parseInt % 10)]
                                                                                                         (re-frame/dispatch [:analysis/update-params :topN (if (js/isNaN n) 20 n)]))
                                                                                        :style {:width "80px"}]]]]]
                                                               [re-com/h-box
                                                                :src (at)
                                                                :gap "12px"
                                                                :children [[re-com/button
                                                                            :src (at)
                                                                            :label "Run Analysis"
                                                                            :class "btn-primary"
                                                                            :disabled? loading?
                                                                            :on-click #(re-frame/dispatch [:analysis/run-sync])]
                                                                           [re-com/button
                                                                            :src (at)
                                                                            :label "Schedule Async"
                                                                            :disabled? loading?
                                                                            :on-click #(re-frame/dispatch [:analysis/run-async])]]]]]])
                                            (when loading?
                                                  [components/loading-spinner "Analyzing data..."])
                                            (when result
                                                  [result-renderer active-analysis result])
                                            ]]]]))))
