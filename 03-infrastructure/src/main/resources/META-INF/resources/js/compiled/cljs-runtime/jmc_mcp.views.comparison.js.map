(ns jmc-mcp.views.comparison
  (:require [reagent.core :as r]
            [re-com.core :as rc]
            [re-frame.core :as rf]
            [jmc-mcp.views.components :as components]))

(defn comparison-header []
  (let [recordings (rf/subscribe [:recordings/items])
        baseline-id (r/atom nil)
        target-id (r/atom nil)]
    (fn []
      [rc/h-box
       :align :center
       :gap "16px"
       :style {:padding "20px" :background-color "white" :border "1px solid #e2e8f0" :border-radius "8px"}
       :children [[rc/v-box :children
                   [[rc/label :label "Baseline Recording" :style {:font-size "12px" :color "#64748b"}]
                    [rc/single-dropdown
                     :choices (for [r @recordings] {:id (:id r) :label (:filename r)})
                     :model baseline-id
                     :on-change #(reset! baseline-id %)
                     :width "300px"
                     :placeholder "Select baseline"]]]
                  [:i {:class "zmdi zmdi-arrow-right" :style {:font-size "24px" :color "#94a3b8"}}]
                  [rc/v-box :children
                   [[rc/label :label "Target Recording" :style {:font-size "12px" :color "#64748b"}]
                    [rc/single-dropdown
                     :choices (for [r @recordings] {:id (:id r) :label (:filename r)})
                     :model target-id
                     :on-change #(reset! target-id %)
                     :width "300px"
                     :placeholder "Select target"]]]
                  [rc/button
                   :label "Compare"
                   :class "btn-primary"
                   :disabled? (not (and @baseline-id @target-id))
                   :on-click #(rf/dispatch [:comparison/run {:baselineRecordingId @baseline-id
                                                              :comparisonRecordingId @target-id
                                                              :analysisType "overview"}])]]])))

(defn metric-row [metric]
  (let [delta (:deltaPercent metric)
        color (cond
                (nil? delta) "#64748b"
                (> delta 10) "#ef4444" ;; regression
                (< delta -10) "#10b981" ;; improvement
                :else "#64748b")]
    [rc/h-box
     :style {:padding "12px 16px" :border-bottom "1px solid #f1f5f9"}
     :children [[rc/label :label (:label metric) :style {:width "250px"}]
                [rc/label :label (:baselineDisplay metric) :style {:width "150px"}]
                [rc/label :label (:targetDisplay metric) :style {:width "150px"}]
                [rc/label :label (if delta (str delta "%") "-") :style {:width "100px" :color color :font-weight 700}]]]))

(defn comparison-results [result]
  [rc/v-box
   :gap "24px"
   :children [[rc/v-box
               :style {:padding "20px" :background-color "white" :border "1px solid #e2e8f0" :border-radius "8px"}
               :children [[rc/label :label "Summary" :style {:font-weight 700 :margin-bottom "12px"}]
                          (for [s (:summary result)]
                            ^{:key s} [rc/label :label (str "• " s) :style {:margin-bottom "4px"}])]]
              (for [[cat metrics] (:metrics result)]
                ^{:key cat}
                [rc/v-box
                 :style {:background-color "white" :border "1px solid #e2e8f0" :border-radius "8px"}
                 :children [[rc/h-box :style {:padding "12px 16px" :background-color "#f8fafc" :border-bottom "1px solid #e2e8f0"}
                             :children [[rc/label :label (name cat) :style {:font-weight 700 :width "250px"}]
                                        [rc/label :label "Baseline" :style {:font-weight 700 :width "150px"}]
                                        [rc/label :label "Target" :style {:font-weight 700 :width "150px"}]
                                        [rc/label :label "Delta" :style {:font-weight 700 :width "100px"}]]]
                            (for [m metrics]
                              ^{:key (:label m)} [metric-row m])]])]])

(defn comparison-page []
  (let [result (rf/subscribe [:comparison/result])
        loading? (rf/subscribe [:comparison/loading?])]
    (fn []
      [rc/v-box
       :gap "24px"
       :children [[rc/h-box :align :center :children
                   [[rc/label :label "Recording Comparison" :style {:font-size "24px" :font-weight 700}]]]
                  [comparison-header]
                  (if @loading?
                    [rc/v-box :align :center :style {:padding "100px"} :children [[components/spinner]]]
                    (if @result
                      [comparison-results @result]
                      [rc/v-box :align :center :style {:padding "100px"} :children [[rc/label :label "Select recordings and click Compare"]]]))]])))
