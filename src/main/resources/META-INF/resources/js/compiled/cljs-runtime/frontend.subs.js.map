(ns frontend.subs
  (:require
   [re-frame.core :as re-frame]
   [frontend.analysis-config :as ac]))

;; Route

(re-frame/reg-sub
 :route/current
 (fn [db _]
   (get-in db [:route :current])))

(re-frame/reg-sub
 :route/params
 (fn [db _]
   (get-in db [:route :params])))

;; Recordings

(re-frame/reg-sub
 :recordings/items
 (fn [db _]
   (get-in db [:recordings :items])))

(re-frame/reg-sub
 :recordings/loading?
 (fn [db _]
   (get-in db [:recordings :loading?])))

(re-frame/reg-sub
 :recordings/error
 (fn [db _]
   (get-in db [:recordings :error])))

;; Recording detail

(re-frame/reg-sub
 :recording-detail/info
 (fn [db _]
   (get-in db [:recording-detail :info])))

(re-frame/reg-sub
 :recording-detail/recording-id
 (fn [db _]
   (get-in db [:recording-detail :recording-id])))

(re-frame/reg-sub
 :recording-detail/active-analysis
 (fn [db _]
   (get-in db [:recording-detail :active-analysis])))

(re-frame/reg-sub
 :recording-detail/analysis-params
 (fn [db _]
   (get-in db [:recording-detail :analysis-params])))

(re-frame/reg-sub
 :recording-detail/results
 (fn [db _]
   (get-in db [:recording-detail :results])))

(re-frame/reg-sub
 :recording-detail/result-for
 (fn [db [_ analysis-type]]
   (let [recording-id (get-in db [:recording-detail :recording-id])]
     (get-in db [:recording-detail :results recording-id analysis-type]))))

(re-frame/reg-sub
 :recording-detail/result
 (fn [db _]
   (let [recording-id (get-in db [:recording-detail :recording-id])
         active (get-in db [:recording-detail :active-analysis])]
     (get-in db [:recording-detail :results recording-id active]))))

(re-frame/reg-sub
 :recording-detail/result-for-active
 (fn [db _]
   (let [recording-id (get-in db [:recording-detail :recording-id])
         active (get-in db [:recording-detail :active-analysis])]
     (get-in db [:recording-detail :results recording-id active]))))

(re-frame/reg-sub
 :recording-detail/loading?
 (fn [db _]
   (get-in db [:recording-detail :loading?])))

(re-frame/reg-sub
 :recording-detail/error
 (fn [db _]
   (get-in db [:recording-detail :error])))

;; Upload

(re-frame/reg-sub
 :upload/status
 (fn [db _]
   (get-in db [:upload :status])))

(re-frame/reg-sub
 :upload/file
 (fn [db _]
   (get-in db [:upload :file])))

(re-frame/reg-sub
 :upload/progress
 (fn [db _]
   (get-in db [:upload :progress])))

(re-frame/reg-sub
 :upload/error
 (fn [db _]
   (get-in db [:upload :error])))

;; Jobs

(re-frame/reg-sub
 :jobs/all
 (fn [db _]
   (get db :jobs)))

(re-frame/reg-sub
 :jobs/running
 (fn [db _]
   (->> (get db :jobs)
        (filter (fn [[_ job]] (#{:pending :running} (:status job))))
        (into {}))))

(re-frame/reg-sub
 :jobs/completed
 (fn [db _]
   (->> (get db :jobs)
        (filter (fn [[_ job]] (#{:completed :failed} (:status job))))
        (into {}))))

;; Comparison

(re-frame/reg-sub
 :comparison/baseline-id
 (fn [db _]
   (get-in db [:comparison :baseline-id])))

(re-frame/reg-sub
 :comparison/target-id
 (fn [db _]
   (get-in db [:comparison :target-id])))

(re-frame/reg-sub
 :comparison/result
 (fn [db _]
   (get-in db [:comparison :result])))

(re-frame/reg-sub
 :comparison/loading?
 (fn [db _]
   (get-in db [:comparison :loading?])))

(re-frame/reg-sub
 :comparison/error
 (fn [db _]
   (get-in db [:comparison :error])))

;; Notifications

(re-frame/reg-sub
 :notifications
 (fn [db _]
   (get db :notifications)))

;; UI

(re-frame/reg-sub
 :ui/sidebar-collapsed?
 (fn [db _]
   (get-in db [:ui :sidebar-collapsed?])))

;; Health

(re-frame/reg-sub
 :health/status
 (fn [db _]
   (get db :health)))

;; Analysis

(re-frame/reg-sub
 :analysis/shape-for-type
 (fn [_ [_ analysis-type]]
   (get ac/analysis-shapes analysis-type :metrics)))
