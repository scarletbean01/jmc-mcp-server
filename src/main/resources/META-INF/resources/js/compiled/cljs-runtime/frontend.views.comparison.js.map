(ns frontend.views.comparison
  (:require
   [re-frame.core :as re-frame]
   [reagent.core :as reagent]
   [re-com.core :as re-com :refer [at]]
   [clojure.string :as str]
   [frontend.subs :as subs]
   [frontend.views.components :as components :refer [md-icon]]))

(defn recording-dropdown [label selected-id on-change]
  (let [recordings @(re-frame/subscribe [:recordings/items])]
    [re-com/v-box
     :src (at)
     :gap "4px"
     :children [[re-com/label
                 :src (at)
                 :label label
                 :style {:font-size "0.875rem" :font-weight "600" :color "#475569"}]
                [re-com/single-dropdown
                 :src (at)
                 :choices (vec (for [r recordings]
                                 {:id (:recordingId r)
                                  :label (or (:filename r) (:recordingId r))}))
                 :model selected-id
                 :placeholder "Select recording..."
                 :on-change on-change
                 :style {:width "300px"}]]]))

(defn metric-row [metric]
  (let [indicator-color (case (:indicator metric)
                          "regression" "#ef4444"
                          "improvement" "#22c55e"
                          "warning" "#f59e0b"
                          "#64748b")
        indicator-bg (case (:indicator metric)
                       "regression" "#fef2f2"
                       "improvement" "#f0fdf4"
                       "warning" "#fffbeb"
                       "#f8fafc")]
    [:tr {:style {:border-bottom "1px solid #f1f5f9"}}
     [:td {:style {:padding "12px 16px" :font-size "0.875rem" :color "#1e293b" :font-weight "500"}}
      (or (:label metric) "-")]
     [:td {:style {:padding "12px 16px" :font-size "0.875rem" :color "#475569"}}
      (or (:baselineDisplay metric) (str (:baselineValue metric)) "-")]
     [:td {:style {:padding "12px 16px" :font-size "0.875rem" :color "#475569"}}
      (or (:targetDisplay metric) (str (:targetValue metric)) "-")]
     [:td {:style {:padding "12px 16px" :text-align "right"}}
      [:span {:style {:padding "2px 8px" :border-radius "9999px" :font-size "0.75rem" :font-weight "700"
                      :color indicator-color :background-color indicator-bg :border (str "1px solid " indicator-color)}}
       (str (or (:deltaPercent metric) "-") "%")]]]))

(defn comparison-category-tab [category metrics]
  [:div {:class "card" :style {:padding "0" :overflow "hidden"}}
   [:table {:style {:width "100%" :border-collapse "collapse"}}
    [:thead {:style {:background-color "#f8fafc" :border-bottom "1px solid #e2e8f0"}}
     [:tr
      [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Metric"]
      [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Baseline"]
      [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Target"]
      [:th {:style {:padding "12px 16px" :text-align "right" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Delta %"]]]
    [:tbody
     (for [m metrics]
       ^{:key (or (:label m) (hash m))}
       [metric-row m])]]])

(defn category-tab-bar [categories active-tab on-change]
  [re-com/h-box
   :src (at)
   :gap "4px"
   :style {:border-bottom "1px solid #e2e8f0" :margin-bottom "1.5rem"}
   :children (vec (for [cat categories]
                    ^{:key cat}
                    [:div {:style (merge {:padding "10px 20px"
                                          :cursor "pointer"
                                          :font-size "0.875rem"
                                          :font-weight "600"
                                          :border-bottom "2px solid transparent"
                                          :transition "all 0.2s"}
                                         (if (= active-tab cat)
                                           {:border-bottom-color "#3b82f6" :color "#2563eb" :background "#eff6ff"}
                                           {:color "#64748b"}))
                           :on-click #(on-change cat)}
                     cat]))])

(defn comparison-view []
  (let [active-tab (reagent/atom nil)]
    (fn []
      (let [baseline-id @(re-frame/subscribe [:comparison/baseline-id])
            target-id @(re-frame/subscribe [:comparison/target-id])
            result @(re-frame/subscribe [:comparison/result])
            loading? @(re-frame/subscribe [:comparison/loading?])
            error @(re-frame/subscribe [:comparison/error])
            categories (keys (:metrics result))]
        (when (and result (nil? @active-tab) (seq categories))
          (reset! active-tab (first categories)))
        [re-com/v-box
         :src (at)
         :gap "2rem"
         :children [[components/page-header "Recording Comparison" "Analyze performance regressions and improvements between two JFR files"]
                    [:div {:class "card" :style {:background-color "#f8fafc" :border-style "dashed"}}
                     [re-com/h-box
                      :src (at)
                      :gap "24px"
                      :align :end
                      :children [[recording-dropdown "Baseline Recording" baseline-id
                                  #(re-frame/dispatch [:comparison/select-baseline %])]
                                 [recording-dropdown "Target Recording" target-id
                                  #(re-frame/dispatch [:comparison/select-target %])]
                                 [re-com/button
                                  :src (at)
                                  :label "Run Comparison"
                                  :class "btn-primary"
                                  :disabled? (or loading? (nil? baseline-id) (nil? target-id))
                                  :on-click #(re-frame/dispatch [:comparison/run])]]]]
                    (when error
                      [re-com/alert-box
                       :src (at)
                       :alert-type :danger
                       :body error])
                    (when loading?
                      [components/loading-spinner "Comparing recordings..."])
                    (when result
                      [re-com/v-box
                       :src (at)
                       :gap "1.5rem"
                       :children [(when (seq (:warnings result))
                                    [re-com/alert-box
                                     :src (at)
                                     :alert-type :warning
                                     :body (str/join "; " (:warnings result))])
                                  (when (seq (:summary result))
                                    [re-com/alert-box
                                     :src (at)
                                     :alert-type :info
                                     :body (str/join "; " (:summary result))])
                                  (when (seq categories)
                                    [category-tab-bar categories @active-tab #(reset! active-tab %)])
                                  (when @active-tab
                                    (let [metrics (get-in result [:metrics @active-tab])]
                                      [comparison-category-tab @active-tab metrics]))]])]]))))
