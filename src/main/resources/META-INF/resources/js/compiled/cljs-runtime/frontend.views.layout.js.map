(ns frontend.views.layout
  (:require
   [re-frame.core :as re-frame]
   [re-com.core :as re-com :refer [at]]
   [frontend.subs :as subs]
   [frontend.views.library :refer [library-view]]
   [frontend.views.analysis-hub :refer [analysis-hub-view]]
   [frontend.views.comparison :refer [comparison-view]]
   [frontend.views.job-monitor :refer [job-monitor]]
   [frontend.views.components :as components :refer [md-icon]]))

(defn header []
  [re-com/h-box
   :src      (at)
   :class    "app-header"
   :height   "64px"
   :padding  "0 1.5rem"
   :align    :center
   :justify  :between
   :children [[re-com/h-box
               :src      (at)
               :gap      "12px"
               :align    :center
               :children [[re-com/md-icon-button
                           :src      (at)
                           :md-icon-name "zmdi-menu"
                           :size     :regular
                           :on-click #(re-frame/dispatch [:ui/toggle-sidebar])
                           :style    {:color "#64748b"}]
                          [re-com/title
                           :src      (at)
                           :label    "JMC MCP"
                           :level    :level3
                           :style    {:margin "0" :font-weight "800" :letter-spacing "-0.025em" :color "#0f172a"}]
                          [:div {:style {:background "#e0f2fe" :color "#0369a1" :padding "2px 8px" :border-radius "9999px" :font-size "0.75rem" :font-weight "600"}}
                           "DASHBOARD"]]]
              [re-com/h-box
               :src      (at)
               :gap      "24px"
               :align    :center
               :children [[re-com/hyperlink
                           :src      (at)
                           :label    "Documentation"
                           :style    {:color "#64748b" :font-weight "500" :font-size "0.875rem"}
                           :on-click #(.open js/window "https://github.com" "_blank")]
                          [re-com/h-box
                           :src      (at)
                           :gap      "8px"
                           :align    :center
                           :children [[md-icon :md-icon-name "zmdi-account-circle" :size :large :style {:color "#94a3b8"}]
                                      [re-com/label :src (at) :label "Admin" :style {:font-weight "500" :font-size "0.875rem"}]]]]]]])

(defn sidebar-item [id label icon-name active?]
  [:div {:class (str "sidebar-item " (when active? "active"))
         :on-click #(re-frame/dispatch [:navigate id])}
   [md-icon :md-icon-name icon-name :size :regular]
   [:span label]])

(defn sidebar []
  (let [collapsed? @(re-frame/subscribe [:ui/sidebar-collapsed?])
        current-route @(re-frame/subscribe [:route/current])]
    [re-com/v-box
     :src      (at)
     :width    (if collapsed? "0px" "260px")
     :style    {:background-color "#0f172a"
                :color            "#f1f5f9"
                :transition       "all 0.3s ease-in-out"
                :overflow         "hidden"
                :border-right     "1px solid #1e293b"}
     :children [[re-com/v-box
                 :src      (at)
                 :gap      "4px"
                 :padding  "16px 8px"
                 :children [[re-com/label
                             :src   (at)
                             :label "MAIN NAVIGATION"
                             :style {:color "#475569" :font-size "0.7rem" :font-weight "700" :letter-spacing "0.05em" :padding "0 16px 8px"}]
                            [sidebar-item :library "Recording Library" "zmdi-collection-item" (= current-route :library)]
                            [sidebar-item :compare "Comparison Tool" "zmdi-compare" (= current-route :compare)]
                            
                            [:div {:style {:height "1px" :background "#1e293b" :margin "16px 16px"}}]
                            
                            [re-com/label
                             :src   (at)
                             :label "SYSTEM"
                             :style {:color "#475569" :font-size "0.7rem" :font-weight "700" :letter-spacing "0.05em" :padding "0 16px 8px"}]
                            [sidebar-item :settings "Settings" "zmdi-settings" (= current-route :settings)]
                            [sidebar-item :health "Health Status" "zmdi-pulse" (= current-route :health)]]]]]))

(defn main-content []
  (let [current-route @(re-frame/subscribe [:route/current])]
    [re-com/box
     :src     (at)
     :size    "1"
     :padding "2rem"
     :style   {:overflow-y "auto"}
     :child   (case current-route
                :library   [library-view]
                :recording [analysis-hub-view]
                :compare   [comparison-view]
                [library-view])]))

(defn app-layout []
  [re-com/v-box
   :src      (at)
   :height   "100vh"
   :children [[header]
              [re-com/h-box
               :src      (at)
               :size     "1"
               :children [[sidebar]
                          [main-content]]]
              [job-monitor]
              [components/notifications-panel]]])
