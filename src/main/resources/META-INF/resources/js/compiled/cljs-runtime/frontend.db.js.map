(ns frontend.db)

(def default-db
  {:route {:current :library
           :params {}}
   :recordings {:items []
                :loading? false
                :error nil}
   :recording-detail {:recording-id nil
                      :info nil
                      :active-analysis nil
                      :analysis-params {:start-time nil
                                        :end-time nil
                                        :topN 20}
                      :results {}
                      :loading? false}
   :upload {:status :idle
            :progress 0
            :error nil}
   :jobs {}
   :comparison {:baseline-id nil
                :target-id nil
                :result nil
                :loading? false
                :error nil}
   :notifications []
   :ui {:sidebar-collapsed? false}})
