(ns frontend.styles
  (:require-macros
    [garden.def :refer [defcssfn]])
  (:require
    [spade.core   :refer [defglobal defclass]]
    [garden.units :refer [deg px]]
    [garden.color :refer [rgba]]))

(def colors
  {:bg-main    "#f8fafc"
   :sidebar-bg "#0f172a"
   :sidebar-hover "#1e293b"
   :sidebar-active "#334155"
   :accent     "#3b82f6"
   :accent-dark "#2563eb"
   :text-main  "#1e293b"
   :text-muted "#64748b"
   :border     "#e2e8f0"
   :white      "#ffffff"
   :success    "#22c55e"
   :error      "#ef4444"
   :warning    "#f59e0b"
   :info       "#3b82f6"})

(defglobal defaults
  [:body
   {:font-family "'Inter', sans-serif"
    :margin      0
    :padding     0
    :color       (:text-main colors)
    :background-color (:bg-main colors)}]
  
  [:.app-header
   {:background-color "#ffffff"
    :border-bottom (str "1px solid " (:border colors))
    :box-shadow "0 1px 2px 0 rgba(0, 0, 0, 0.05)"
    :z-index 1000}]
  
  [:.sidebar-item
   {:padding "10px 16px"
    :margin "4px 8px"
    :border-radius "8px"
    :cursor "pointer"
    :transition "all 0.2s"
    :color "#94a3b8"
    :display "flex"
    :align-items "center"
    :gap "12px"}]
  
  [:.sidebar-item:hover
   {:background-color (:sidebar-hover colors)
    :color "#f1f5f9"}]
  
  [:.sidebar-item.active
   {:background-color (:sidebar-active colors)
    :color "#ffffff"
    :font-weight "500"}]

  [:.card
   {:background-color (:white colors)
    :border (str "1px solid " (:border colors))
    :border-radius "12px"
    :box-shadow "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)"
    :padding "1.5rem"
    :margin-bottom "1rem"}]

  [:.btn-primary
   {:background-color (:accent colors)
    :color "#fff"
    :border "none"
    :border-radius "8px"
    :padding "8px 16px"
    :font-weight "500"
    :transition "background-color 0.2s"}]
  
  [:.btn-primary:hover
   {:background-color (:accent-dark colors)}]

  [:.recording-row
   {:border-bottom (str "1px solid " (:border colors))
    :transition "background-color 0.1s"}]
  
  [:.recording-row:hover
   {:background-color "#f1f5f9 !important"}]

  [:.page-header
   {:margin-bottom "2rem"}]
  
  [:.section-title
   {:font-weight "600"
    :font-size "1.1rem"
    :margin-bottom "1rem"
    :color (:text-main colors)}]

  ;; re-com overrides
  [:.rc-title
   {:font-family "'Inter', sans-serif !important"
    :font-weight "600 !important"}]
  
  [:.rc-label
   {:font-family "'Inter', sans-serif !important"}]
  
  [:.rc-button
   {:border-radius "8px !important"
    :font-weight "500 !important"}]
  )
