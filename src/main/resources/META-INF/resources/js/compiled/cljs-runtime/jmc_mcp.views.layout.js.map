(ns jmc-mcp.views.layout
  (:require [re-com.core :as rc]
            [re-frame.core :as rf]
            [reitit.frontend.easy :as rfe]
            [jmc-mcp.views.components :as components]
            [jmc-mcp.views.library :as library]
            [jmc-mcp.views.analysis-hub :as analysis-hub]
            [jmc-mcp.views.comparison :as comparison]
            [jmc-mcp.views.job-monitor :as job-monitor]))

(defn nav-item [label route-name icon]
  (let [current-route (rf/subscribe [:route/current])]
    (fn []
      [rc/h-box
       :align :center
       :class (str "nav-item " (when (= @current-route route-name) "active"))
       :style {:padding "12px 20px" :cursor "pointer" :gap "12px"
               :background-color (when (= @current-route route-name) "#e2e8f0")}
       :attr {:on-click #(rfe/push-state route-name)}
       :children [[:i {:class (str "zmdi " icon) :style {:font-size "24px"}}]
                  [rc/label :label label :style {:font-weight 500}]]])))

(defn sidebar []
  [rc/v-box
   :width "260px"
   :style {:background-color "#f1f5f9" :border-right "1px solid #cbd5e1" :height "100%"}
   :children [[rc/v-box
               :style {:padding "24px 20px" :border-bottom "1px solid #cbd5e1"}
               :children [[rc/label :label "JMC MCP" :style {:font-size "20px" :font-weight 700 :color "#0f172a"}]
                          [rc/label :label "Dashboard" :style {:font-size "14px" :color "#64748b"}]]]
              [rc/v-box
               :children [[nav-item "Library" :library "zmdi-collection-item"]
                          [nav-item "Comparison" :compare "zmdi-compare"]]]] ])

(defn main-content []
  (let [current-route (rf/subscribe [:route/current])]
    (fn []
      [rc/v-box
       :size "1"
       :style {:padding "30px" :overflow "auto" :background-color "#f8fafc"}
       :children [(case @current-route
                    :library [library/library-page]
                    :recording-detail [analysis-hub/analysis-hub-page]
                    :compare [comparison/comparison-page]
                    [rc/label :label "Not Found"])]])))

(defn main-layout []
  [rc/h-box
   :height "100vh"
   :children [[sidebar]
              [main-content]
              [components/notification-stack]
              [job-monitor/job-monitor]]])
