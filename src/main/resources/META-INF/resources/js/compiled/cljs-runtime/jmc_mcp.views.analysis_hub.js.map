(ns jmc-mcp.views.analysis-hub
  (:require [re-com.core :as rc]
            [re-frame.core :as rf]
            [jmc-mcp.views.components :as components]
            ["react-chartjs-2" :refer [Line]]
            ["chart.js/auto"]))

(defn timeline-renderer [data x-key y-key]
  (let [chart-data {:labels (map #(get % x-key) data)
                    :datasets [{:label (name y-key)
                                :data (map #(get % y-key) data)
                                :borderColor "rgb(75, 192, 192)"
                                :tension 0.1}]}]
    [:div {:style {:padding "20px" :background-color "white" :border "1px solid #e2e8f0" :border-radius "8px"}}
     [:> Line {:data (clj->js chart-data)}]]))

(defn flame-graph-renderer [data]
  [rc/v-box
   :align :center
   :style {:padding "40px" :background-color "white" :border "1px solid #e2e8f0" :border-radius "8px"}
   :children [[rc/label :label "Flame Graph (SVG Implementation)"]
              [:svg {:width "100%" :height "400"}
               [:rect {:x "0" :y "0" :width "100%" :height "400" :fill "#f8fafc"}]
               [rc/label :label "SVG Flame Graph goes here" :style {:margin-top "180px"}]]]])

(def analysis-config
  {:overview         {:label "Overview" :shape :metrics :sections [:jvm :cpu :memory :gc]}
   :hot-methods      {:label "Hot Methods" :shape :table :columns [{:key :methodName :label "Method"}
                                                                   {:key :sampleCount :label "Samples"}]}
   :cpu-flame        {:label "CPU Flame Graph" :shape :flame-graph :depth-key :stackDepth :value-key :sampleCount}
   :call-tree        {:label "Call Tree" :shape :tree :children-key :children :label-key :methodName}
   :heap-trends      {:label "Heap Trends" :shape :timeline :x-key :timestamp :y-key :heapUsed}
   :exceptions       {:label "Exceptions" :shape :table :columns [{:key :type :label "Type"}
                                                                 {:key :message :label "Message"}
                                                                 {:key :count :label "Count"}]}})

(def categories
  [{:label "Overview" :items [:overview]}
   {:label "CPU & Compilation" :items [:hot-methods :cpu-flame :call-tree]}
   {:label "Memory" :items [:heap-trends]}
   {:label "Diagnostics" :items [:exceptions]}])

(defn analysis-sidebar-item [type]
  (let [config (get analysis-config type)
        active-type (rf/subscribe [:recording-detail/active-analysis])]
    (fn []
      [rc/h-box
       :align :center
       :class (str "analysis-item " (when (= @active-type type) "active"))
       :style {:padding "8px 16px" :cursor "pointer" :gap "8px"
               :background-color (when (= @active-type type) "#f1f5f9")}
       :attr {:on-click #(rf/dispatch [:analysis/select-type type])}
       :children [[rc/label :label (:label config) :style {:font-size "14px"}]]])))

(defn analysis-sidebar []
  [rc/v-box
   :width "220px"
   :style {:border-right "1px solid #e2e8f0"}
   :children (for [cat categories]
               ^{:key (:label cat)}
               [rc/v-box
                :children [[rc/label :label (:label cat) :style {:padding "12px 16px" :font-weight 700 :color "#64748b" :font-size "12px"}]
                           (for [item (:items cat)]
                             ^{:key item} [analysis-sidebar-item item])]])])

(defn metrics-renderer [data]
  [rc/v-box
   :gap "20px"
   :children (for [[section metrics] data]
               ^{:key section}
               [rc/v-box :gap "12px" :children
                [[rc/label :label (name section) :style {:font-weight 700 :text-transform "uppercase" :font-size "12px" :color "#64748b"}]
                 [rc/h-box :gap "16px" :wrap? true :children
                  (for [[k v] metrics]
                    ^{:key k}
                    [rc/v-box :style {:padding "16px" :background-color "white" :border "1px solid #e2e8f0" :border-radius "8px" :min-width "180px"}
                     :children [[rc/label :label (name k) :style {:font-size "12px" :color "#64748b"}]
                                [rc/label :label (str v) :style {:font-size "18px" :font-weight 700}]]])]]])])

(defn table-renderer [data columns]
  [rc/v-box
   :style {:background-color "white" :border "1px solid #e2e8f0" :border-radius "8px"}
   :children [[rc/h-box :style {:padding "12px 16px" :background-color "#f8fafc" :border-bottom "1px solid #e2e8f0"}
               :children (for [col columns]
                           ^{:key (:key col)} [rc/label :label (:label col) :style {:font-weight 700 :width "200px"}])]
              (for [row data]
                ^{:key (str row)}
                [rc/h-box :style {:padding "12px 16px" :border-bottom "1px solid #f1f5f9"}
                 :children (for [col columns]
                             ^{:key (:key col)} [rc/label :label (str (get row (:key col))) :style {:width "200px"}])])]])

(defn result-panel []
  (let [active-type (rf/subscribe [:recording-detail/active-analysis])
        result (rf/subscribe [:recording-detail/result @active-type])
        loading? (rf/subscribe [:recording-detail/loading?])]
    (fn []
      [rc/v-box
       :size "1"
       :children (if @loading?
                   [[rc/v-box :align :center :style {:padding "100px"} :children [[components/spinner]]]]
                   (if-let [data (:data @result)]
                     (let [config (get analysis-config @active-type)]
                       [(case (:shape config)
                          :metrics [metrics-renderer data]
                          :table [table-renderer data (:columns config)]
                          :timeline [timeline-renderer data (:x-key config) (:y-key config)]
                          :flame-graph [flame-graph-renderer data]
                          [rc/label :label (str "Renderer for " (:shape config) " not implemented")])])
                     [[rc/v-box :align :center :style {:padding "100px"} :children [[rc/label :label "No data"]]]]))])))

(defn analysis-hub-page []
  (let [recording-id (:id @(rf/subscribe [:route/params]))]
    [rc/v-box
     :gap "24px"
     :children [[rc/h-box :align :center :children
                 [[rc/label :label "Analysis Hub" :style {:font-size "24px" :font-weight 700}]]]
                [rc/h-box
                 :size "1"
                 :style {:background-color "white" :border "1px solid #e2e8f0" :border-radius "8px" :min-height "600px"}
                 :children [[analysis-sidebar]
                            [result-panel]]]]]))
