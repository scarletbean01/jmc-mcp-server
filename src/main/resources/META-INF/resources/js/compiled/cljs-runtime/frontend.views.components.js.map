(ns frontend.views.components
  (:require
   [re-frame.core :as re-frame]
   [reagent.core :as reagent]
   [re-com.core :as re-com :refer [at md-icon-button]]
   [frontend.subs :as subs]))

(defn md-icon
  [& args]
  (let [{:keys [md-icon-name size style class color]} (if (map? (first args)) (first args) (apply hash-map args))]
    [:i {:class (str "zmdi " md-icon-name " " (when class class))
         :style (merge (when color {:color color})
                       (when size
                         {:font-size (case size
                                       :smaller "12px"
                                       :small "14px"
                                       :regular "18px"
                                       :large "24px"
                                       :larger "32px"
                                       size)})
                       style)}]))

(defn notification-toast
  [{:keys [id type message]}]
  (let [alert-type (case type
                     :success :success
                     :error :danger
                     :warning :warning
                     :info :info
                     :info)]
    [re-com/alert-box
     :src (at)
     :alert-type alert-type
     :body message
     :style {:margin-bottom "8px" :box-shadow "0 4px 6px -1px rgba(0,0,0,0.1)"}
     :closeable? true
     :on-close #(re-frame/dispatch [:notification/remove id])]))

(defn notifications-panel []
  (let [notifications @(re-frame/subscribe [:notifications])]
    (if (seq notifications)
      [re-com/v-box
       :src (at)
       :class "notification-container"
       :style {:position "fixed"
               :top "1.5rem"
               :right "1.5rem"
               :z-index 9999
               :max-width "400px"}
       :children (vec (for [n notifications]
                        ^{:key (:id n)} [notification-toast n]))]
      [:div])))

(defn loading-spinner
  ([]
   [loading-spinner "Loading..."])
  ([text]
   [re-com/h-box
    :src (at)
    :gap "12px"
    :align :center
    :justify :center
    :style {:padding "2rem"}
    :children [[re-com/throbber
                :src (at)
                :size :regular]
               [re-com/label
                :src (at)
                :label text
                :style {:font-weight "500" :color "#64748b"}]]]))

(defn file-size-str [bytes]
  (cond
    (nil? bytes) "Unknown"
    (>= bytes (* 1024 1024 1024)) (str (.toFixed (/ bytes 1024 1024 1024) 2) " GB")
    (>= bytes (* 1024 1024)) (str (.toFixed (/ bytes 1024 1024) 2) " MB")
    (>= bytes 1024) (str (.toFixed (/ bytes 1024) 2) " KB")
    :else (str bytes " B")))

(defn empty-state
  [message & [action]]
  [re-com/v-box
   :src (at)
   :gap "16px"
   :align :center
   :justify :center
   :style {:padding "4rem 2rem" :background "#fff" :border-radius "12px" :border "1px dashed #e2e8f0"}
   :children (cond-> [[md-icon
                       :md-icon-name "zmdi-inbox"
                       :size :larger
                       :style {:color "#cbd5e1"}]
                      [re-com/label
                       :src (at)
                       :label message
                       :style {:color "#64748b" :font-size "1.1rem"}]]
               action (conj action))])

(defn page-header
  [title & [subtitle]]
  [re-com/v-box
   :src (at)
   :class "page-header"
   :children [[re-com/title
               :src (at)
               :label title
               :level :level2
               :style {:margin "0" :font-weight "700" :color "#0f172a"}]
              (when subtitle
                [re-com/label
                 :src (at)
                 :label subtitle
                 :style {:color "#64748b" :font-size "1rem" :margin-top "4px"}])]])

;; -- Result renderers --

(defn metrics-renderer [data]
  (let [items (cond
                (map? data) (map (fn [[k v]] {:key (name k) :value v}) data)
                (sequential? data) data
                :else [{:key "Result" :value data}])]
    [:div {:style {:display "grid"
                   :grid-template-columns "repeat(auto-fill, minmax(240px, 1fr))"
                   :gap "1rem"}}
     (for [item items]
       ^{:key (or (:key item) (str item))}
       [:div {:class "card" :style {:padding "1rem" :margin-bottom "0"}}
        [re-com/v-box
         :src (at)
         :gap "4px"
         :children [[re-com/label
                     :src (at)
                     :label (str (or (:key item) (:label item)))
                     :style {:font-size "0.875rem" :color "#64748b" :font-weight "500"}]
                    [re-com/label
                     :src (at)
                     :label (str (or (:value item) (:val item)))
                     :style {:font-size "1.25rem" :font-weight "600" :color "#0f172a"}]]]])]))

(defn table-renderer [data]
  (let [rows (if (sequential? data) data [data])]
    (if (empty? rows)
      [empty-state "No data available"]
      (let [cols (keys (first rows))]
        [:div {:class "card" :style {:padding "0" :overflow "hidden"}}
         [:table {:style {:width "100%" :border-collapse "collapse"}}
          [:thead {:style {:background-color "#f8fafc" :border-bottom "1px solid #e2e8f0"}}
           [:tr
            (for [c cols]
              ^{:key c}
              [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}}
               (name c)])]]
          [:tbody
           (for [[idx row] (map-indexed vector rows)]
             ^{:key (hash row)}
             [:tr {:style {:border-bottom (when-not (= idx (dec (count rows))) "1px solid #f1f5f9")
                           :background-color (when (odd? idx) "#fafafa")}}
              (for [c cols]
                ^{:key c}
                [:td {:style {:padding "12px 16px" :color "#334155" :font-size "0.875rem"}}
                 (str (get row c))])])]]]))))

(defn tree-node [node level]
  (let [expanded? (reagent/atom true)]
    (fn [node level]
      (let [label (or (:methodName node) (:name node) (:label node) (str node))
            children (seq (or (:children node) (:childNodes node)))]
        [re-com/v-box
         :src (at)
         :children (vec (concat
                         [[re-com/h-box
                           :src (at)
                           :gap "8px"
                           :align :center
                           :style {:padding-left (str (* level 20) "px")
                                   :padding "6px 0"
                                   :border-bottom "1px solid #f8fafc"}
                           :children [(if children
                                        [re-com/md-icon-button
                                         :src (at)
                                         :md-icon-name (if @expanded? "zmdi-chevron-down" "zmdi-chevron-right")
                                         :size :smaller
                                         :on-click #(swap! expanded? not)
                                         :style {:padding "0" :width "20px" :height "20px"}]
                                        [:div {:style {:width "20px"}}])
                                      [re-com/label
                                       :src (at)
                                       :label label
                                       :style {:font-size "0.875rem" :color "#334155"}]]]]
                         (when (and @expanded? children)
                           (for [child children]
                             ^{:key (hash child)}
                             [tree-node child (inc level)]))))]))))

(defn tree-renderer [data]
  (let [roots (if (sequential? data) data [data])]
    [:div {:class "card" :style {:padding "1rem"}}
     (for [root roots]
       ^{:key (hash root)}
       [tree-node root 0])]))

(defn flame-graph-placeholder [data]
  [:div {:class "card" :style {:padding "3rem" :text-align "center" :background "#f8fafc" :border "2px dashed #e2e8f0"}}
   [re-com/v-box
    :src (at)
    :gap "12px"
    :align :center
    :children [[md-icon
                :md-icon-name "zmdi-fire"
                :size :larger
                :style {:color "#ef4444"}]
               [re-com/label
                :src (at)
                :label "Flame Graph Visualization"
                :style {:font-weight "600" :font-size "1.1rem"}]
               [re-com/label
                :src (at)
                :label "(Placeholder — D3 integration in Phase 7)"
                :style {:color "#64748b"}]]]])

(defn timeline-placeholder [data]
  [:div {:class "card" :style {:padding "3rem" :text-align "center" :background "#f8fafc" :border "2px dashed #e2e8f0"}}
   [re-com/v-box
    :src (at)
    :gap "12px"
    :align :center
    :children [[md-icon
                :md-icon-name "zmdi-chart"
                :size :larger
                :style {:color "#3b82f6"}]
               [re-com/label
                :src (at)
                :label "Timeline Visualization"
                :style {:font-weight "600" :font-size "1.1rem"}]
               [re-com/label
                :src (at)
                :label "(Placeholder — chart library in Phase 7)"
                :style {:color "#64748b"}]]]])
