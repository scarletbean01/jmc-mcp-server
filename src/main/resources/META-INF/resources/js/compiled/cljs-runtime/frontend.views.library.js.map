(ns frontend.views.library
  (:require
   [re-frame.core :as re-frame]
   [reagent.core :as reagent]
   [re-com.core :as re-com :refer [at md-icon-button]]
   [clojure.string :as str]
   [frontend.subs :as subs]
   [frontend.routes :as routes]
   [frontend.views.components :as components :refer [md-icon]]))

(defn upload-zone []
  (let [drag-over? (reagent/atom false)]
    (fn []
      (let [file @(re-frame/subscribe [:upload/file])
            status @(re-frame/subscribe [:upload/status])
            progress @(re-frame/subscribe [:upload/progress])
            error @(re-frame/subscribe [:upload/error])]
        [:div {:class "card"
               :style (merge {:border "2px dashed #e2e8f0"
                              :background-color "#f8fafc"
                              :cursor "pointer"
                              :transition "all 0.2s"
                              :padding "3rem"}
                             (when @drag-over?
                               {:border-color "#3b82f6"
                                :background-color "#eff6ff"}))
               :on-drag-over (fn [e]
                               (.preventDefault e)
                               (reset! drag-over? true))
               :on-drag-leave (fn [e]
                                (.preventDefault e)
                                (reset! drag-over? false))
               :on-drop (fn [e]
                          (.preventDefault e)
                          (reset! drag-over? false)
                          (let [dropped-file (-> e .-dataTransfer .-files (aget 0))]
                            (when dropped-file
                              (re-frame/dispatch [:upload/select-file dropped-file]))))
               :on-click #(when (and (not file) (not= status :uploading))
                            (when-let [el (.getElementById js/document "file-input")]
                              (.click el)))}
         [re-com/v-box
          :src (at)
          :gap "16px"
          :align :center
          :children [(if (= status :uploading)
                       [md-icon
                        :md-icon-name "zmdi-hourglass-alt"
                        :size :larger
                        :color "#3b82f6"]
                       [md-icon
                        :md-icon-name "zmdi-cloud-upload"
                        :size :larger
                        :color "#3b82f6"])
                     (cond
                       (= status :uploading)
                       [re-com/title
                        :src (at)
                        :label "Uploading..."
                        :level :level4]

                       file
                       [re-com/v-box
                        :src (at)
                        :gap "4px"
                        :align :center
                        :children [[re-com/title
                                    :src (at)
                                    :label (.-name file)
                                    :level :level4]
                                   [re-com/label
                                    :src (at)
                                    :label (components/file-size-str (.-size file))
                                    :style {:color "#64748b"}]]]

                       :else
                       [re-com/v-box
                        :src (at)
                        :align :center
                        :gap "4px"
                        :children [[re-com/title
                                    :src (at)
                                    :label "Drop a JFR file here or click to browse"
                                    :level :level4]
                                   [re-com/label
                                    :src (at)
                                    :label "Support files up to 1GB"
                                    :style {:color "#94a3b8" :font-size "0.875rem"}]]])
                     [:input {:id "file-input"
                              :type "file"
                              :accept ".jfr"
                              :style {:display "none"}
                              :on-change #(re-frame/dispatch [:upload/select-file
                                                              (-> % .-target .-files (aget 0))])}]
                     (when (= status :uploading)
                       [re-com/v-box
                        :src (at)
                        :gap "8px"
                        :style {:width "100%"}
                        :children [[re-com/label
                                    :src (at)
                                    :label (str "Uploading... " (.toFixed progress 0) "%")
                                    :style {:font-weight "600" :font-size "0.875rem"}]
                                   [re-com/progress-bar
                                    :src (at)
                                    :model progress
                                    :width "100%"]]])
                     (when (and file (not= status :uploading))
                       [re-com/h-box
                        :src (at)
                        :gap "12px"
                        :children [[re-com/button
                                    :src (at)
                                    :label "Start Upload"
                                    :class "btn-primary"
                                    :on-click #(re-frame/dispatch [:upload/submit])]
                                   [re-com/button
                                    :src (at)
                                    :label "Clear"
                                    :on-click #(re-frame/dispatch [:upload/select-file nil])]]])
                     (when error
                       [re-com/alert-box
                        :src (at)
                        :alert-type :danger
                        :body error])]]]))))

(defn recording-row [idx r]
  [:tr {:class "recording-row"
        :on-click #(re-frame/dispatch [:navigate [:recording {:id (:recordingId r)}]])
        :style {:cursor "pointer"}}
   [:td {:style {:padding "16px"}}
    [re-com/h-box
     :src (at)
     :gap "12px"
     :align :center
     :children [[md-icon
                 :md-icon-name "zmdi-file-text"
                 :size :large
                 :color "#3b82f6"]
                [re-com/v-box
                 :src (at)
                 :children [[re-com/label
                             :src (at)
                             :label (:filename r "Unknown")
                             :style {:font-weight "600" :color "#0f172a"}]
                            [re-com/label
                             :src (at)
                             :label (str "ID: " (:recordingId r))
                             :style {:font-size "0.75rem" :color "#64748b"}]]]]]]
   [:td {:style {:padding "16px" :color "#475569" :font-size "0.875rem"}}
    (components/file-size-str (:size r))]
   [:td {:style {:padding "16px" :color "#475569" :font-size "0.875rem"}}
    (str (or (:eventCount r) "-"))]
   [:td {:style {:padding "16px" :color "#475569" :font-size "0.875rem"}}
    (or (:uploadTime r) "-")]
   [:td {:style {:padding "16px" :text-align "right"}}
    [re-com/h-box
     :src (at)
     :gap "8px"
     :justify :end
     :children [[re-com/md-icon-button
                 :src (at)
                 :md-icon-name "zmdi-eye"
                 :size :smaller
                 :tooltip "View Analysis"
                 :on-click (fn [e]
                             (.stopPropagation e)
                             (re-frame/dispatch [:navigate [:recording {:id (:recordingId r)}]]))]
                [re-com/md-icon-button
                 :src (at)
                 :md-icon-name "zmdi-delete"
                 :size :smaller
                 :tooltip "Delete"
                 :on-click (fn [e]
                             (.stopPropagation e)
                             (re-frame/dispatch [:library/delete-recording (:recordingId r)]))]]]]])

(defn recordings-table [recordings]
  [:div {:class "card" :style {:padding "0" :overflow "hidden"}}
   [:table {:style {:width "100%" :border-collapse "collapse"}}
    [:thead {:style {:background-color "#f8fafc" :border-bottom "1px solid #e2e8f0"}}
     [:tr
      [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Filename"]
      [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Size"]
      [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Events"]
      [:th {:style {:padding "12px 16px" :text-align "left" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} "Uploaded"]
      [:th {:style {:padding "12px 16px" :text-align "right" :font-size "0.75rem" :text-transform "uppercase" :color "#64748b" :font-weight "600"}} ""]]]
    [:tbody
     (for [[idx r] (map-indexed vector recordings)]
       ^{:key (:recordingId r)}
       [recording-row idx r])]]])

(defn library-view []
  (let [recordings @(re-frame/subscribe [:recordings/items])
        loading? @(re-frame/subscribe [:recordings/loading?])
        error @(re-frame/subscribe [:recordings/error])]
    [re-com/v-box
     :src (at)
     :gap "2rem"
     :children [[components/page-header "Recording Library" "Manage and analyze your JFR recordings"]
                [upload-zone]
                (when error
                  [re-com/alert-box
                   :src (at)
                   :alert-type :danger
                   :body error])
                (cond
                  loading?
                  [components/loading-spinner "Loading recordings..."]

                  (empty? recordings)
                  [components/empty-state
                   "No recordings found. Upload a JFR file to get started."
                   [re-com/button
                    :src (at)
                    :label "Upload a JFR file"
                    :class "btn-primary"
                    :on-click #(when-let [el (.getElementById js/document "file-input")]
                                 (.click el))]]

                  :else
                  [recordings-table recordings])]]))
