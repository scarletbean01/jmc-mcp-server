(ns jmc-mcp.views.library
  (:require [re-com.core :as rc]
            [re-frame.core :as rf]
            [reitit.frontend.easy :as rfe]
            [jmc-mcp.views.components :as components]))

(defn upload-zone []
  (let [uploading? (rf/subscribe [:upload/status])]
    (fn []
      [rc/v-box
       :align :center
       :style {:padding "40px" :border "2px dashed #cbd5e1" :border-radius "8px" :background-color "white" :gap "16px"}
       :children [[:i {:class "zmdi zmdi-upload" :style {:font-size "48px" :color "#94a3b8"}}]
                  [rc/v-box :align :center :children
                   [[rc/label :label "Drop JFR files here or click to upload" :style {:font-weight 600}]
                    [rc/label :label "Max size 100MB" :style {:font-size "12px" :color "#64748b"}]]]
                  [rc/button
                   :label "Select File"
                   :class "btn-primary"
                   :on-click #(.click (.getElementById js/document "file-upload"))]
                  [:input {:id "file-upload"
                           :type "file"
                           :accept ".jfr"
                           :style {:display "none"}
                           :on-change (fn [e]
                                        (let [file (-> e .-target .-files (aget 0))]
                                          (when file
                                            (rf/dispatch [:upload/submit file]))))}]]])))

(defn recording-row [recording]
  [rc/h-box
   :align :center
   :style {:padding "12px 20px" :border-bottom "1px solid #f1f5f9" :background-color "white"}
   :children [[rc/v-box :size "1" :children
               [[rc/label :label (:filename recording) :style {:font-weight 600}]
                [rc/label :label (str (:size recording) " bytes • " (:uploadTime recording)) :style {:font-size "12px" :color "#64748b"}]]]
              [rc/h-box :gap "8px" :children
               [[rc/button
                 :label "Analyze"
                 :class "btn-sm btn-outline-primary"
                 :on-click #(rfe/push-state :recording-detail {:id (:id recording)})]
                [rc/button
                 :label "Delete"
                 :class "btn-sm btn-outline-danger"
                 :on-click #(rf/dispatch [:library/delete-recording (:id recording)])]]]]])

(defn library-page []
  (let [recordings (rf/subscribe [:recordings/items])
        loading? (rf/subscribe [:recordings/loading?])]
    (rf/dispatch [:library/load-recordings])
    (fn []
      [rc/v-box
       :gap "24px"
       :children [[rc/h-box
                   :align :center
                   :justify :between
                   :children [[rc/label :label "Recording Library" :style {:font-size "24px" :font-weight 700}]
                              [rc/button
                               :label "Refresh"
                               :class "btn-outline-secondary"
                               :on-click #(rf/dispatch [:library/load-recordings])]]]
                  [upload-zone]
                  [rc/v-box
                   :style {:border "1px solid #e2e8f0" :border-radius "8px" :overflow "hidden" :background-color "white"}
                   :children (if @loading?
                               [[rc/v-box :align :center :style {:padding "60px"} :children [[components/spinner] [rc/label :label "Loading recordings..." :style {:margin-top "12px"}]]]]
                               (if (empty? @recordings)
                                 [[rc/v-box :align :center :style {:padding "60px" :gap "12px"} :children
                                   [[rc/label :label "No recordings found" :style {:font-size "18px" :font-weight 600 :color "#64748b"}]
                                    [rc/label :label "Upload a JFR file to get started" :style {:color "#94a3b8"}]]]]
                                 (for [r @recordings]
                                   ^{:key (:id r)} [recording-row r])))]]])))
